<!doctype html>
<html lang="es">
  <body style="margin:0;background:#f4f4f5;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1f2430;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e6e7eb;">
            <tr>
              <td style="padding:28px 28px 8px;">
                <p style="margin:0 0 16px;font-size:16px;line-height:1.5;">¡Hola {{nombre}}! 👋</p>
                <p style="margin:0 0 16px;font-size:15px;line-height:1.6;">
                  Gracias por suscribirte al boletín de Juguetería Yiyi. Desde ahora vas a ser de los
                  primeros en enterarte de nuestras novedades, lanzamientos y promociones para la caja
                  de juguetes de tus peques. 🧸
                </p>
                {{bloque_cupon}}
                <p style="margin:24px 0;">
                  <a href="{{url_tienda}}" style="display:inline-block;background:#1f2430;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:10px;font-size:14px;font-weight:600;">Ver la tienda</a>
                </p>
                <p style="margin:0 0 4px;font-size:15px;line-height:1.6;">¡Gracias por elegirnos! 💛</p>
                <p style="margin:0;font-size:13px;color:#6b7280;">Equipo de Juguetería Yiyi — Santa Cruz de la Sierra</p>
              </td>
            </tr>
            <tr>
              <td style="padding:18px 28px 24px;border-top:1px solid #eef0f2;">
                <p style="margin:0;font-size:11px;color:#9aa1ad;line-height:1.5;">
                  Recibís este correo porque te suscribiste en yiyi.lat.
                  <a href="{{unsubscribe_url}}" style="color:#9aa1ad;">Cancelar suscripción</a>.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
