FROM node:24.14.1-alpine
RUN apk add --no-cache bash
WORKDIR /usr/src/app

# Instalar todas las dependencias (incluyendo dev — necesarias para migrations
# que corren con ts-node + env-cmd, y para los CLIs typeorm/nest).
COPY package*.json ./
RUN npm ci --no-audit --no-fund

# Copiar código y buildear
COPY . .
RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build

# Startup scripts
RUN chmod +x /usr/src/app/startup.prod.sh /usr/src/app/startup.worker.sh && \
    sed -i 's/\r//g' /usr/src/app/startup.prod.sh /usr/src/app/startup.worker.sh

ENV NODE_ENV=production
EXPOSE 3100
CMD ["/usr/src/app/startup.prod.sh"]
