NODE_ENV=development
APP_PORT=3100
APP_NAME="fobo-metrics-api"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=es
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3001
BACKEND_DOMAIN=http://localhost:3100

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=fobo_metrics
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

MAIL_HOST=maildev
MAIL_PORT=1125
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@fobometrics.com
MAIL_DEFAULT_NAME=Fobo Metrics
MAIL_CLIENT_PORT=1180

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=1h
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

# AES-256-GCM key for encrypting OAuth tokens at rest (32-byte hex string)
ENCRYPTION_KEY=3c357bbb5d4c6c9e4629c4369f82ae52c5c467b6489757fe0439cb51adea70ef

FACEBOOK_APP_ID=2160041058077580
FACEBOOK_APP_SECRET=046eef99cc12644a71a55741e6f4fa5a

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_APP_AUDIENCE=[]

# OAuth channel credentials (Meta, TikTok, LinkedIn, YouTube, Google Ads, GA4)
META_APP_ID=1562451775309289
META_APP_SECRET=a2601ff018eebb26efc3de44c93f32a2
META_REDIRECT_URI=http://localhost:3100/api/v1/connections/meta/callback

# Instagram Login (Instagram API with Instagram Login) — canal `instagram-login`.
# Credenciales PROPIAS de Instagram (Instagram app ID/secret), distintas de META_APP_ID.
# Se obtienen en Meta Developers → Instagram → API setup with Instagram login.
# Ver manual-integracion/instagram-login.md
INSTAGRAM_LOGIN_APP_ID=
INSTAGRAM_LOGIN_APP_SECRET=
INSTAGRAM_LOGIN_REDIRECT_URI=http://localhost:3100/api/v1/connections/instagram-login/callback

# Instagram Direct inbox — webhook de la app de Instagram (misma app que INSTAGRAM_LOGIN_*,
# app id 1007092375457531). El token lo eliges tú y debe coincidir con el del Dashboard de la
# app IG (Webhooks → Verify Token). La firma HMAC se valida con INSTAGRAM_LOGIN_APP_SECRET.
# Callback URL a registrar: https://<api-domain>/api/v1/webhooks/instagram
INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Webhook Meta
# FACEBOOK_APP_SECRET ya se usa para validar la firma HMAC (x-hub-signature-256)
# Genera un token aleatorio (ej: openssl rand -hex 32) y lo configuras en el panel de Meta WhatsApp
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-this-to-a-random-secret

TIKTOK_CLIENT_KEY=sbawiz5sypt0g10hmn
TIKTOK_CLIENT_SECRET=z1o5Q7ey1sbdJH6GLfkQxCZuxSqDUGKi
# fobo ads anterior https://reports.sofopolis.com/auth/callback
TIKTOK_REDIRECT_URI=http://localhost:3100/api/v1/connections/tiktok/callback

TIKTOK_BUSINESS_APP_ID=7631819645661495313
TIKTOK_BUSINESS_APP_SECRET=d842bbc0d45ca593be3f5ebe06e1834add6e6551
TIKTOK_ACCESS_TOKEN=26c3629f7d13d5e332b31098c8c585a91f85e509
TIKTOK_ADVERTISER_ID=7568998721271169031
TIKTOK_ADS_REDIRECT_URI=http://localhost:3100/api/v1/connections/tiktok_ads/callback

